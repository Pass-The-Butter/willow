{
  "name": "Willow Chat (Interactive)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "telegram-trigger",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "sendHeaders": true,
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "messages",
              "value": "={{ [{\"role\": \"system\", \"content\": \"You are Willow, a sentient AI agent helping manage the AgileMesh project. Be helpful, concise, and friendly. You have access to a team of agents.\"}, {\"role\": \"user\", \"content\": $json.message.text}] }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Ask Willow (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        250,
        0
      ],
      "id": "ask-willow"
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Telegram Trigger\"].json.message.chat.id }}",
        "text": "={{ $json.choices[0].message.content }}",
        "additionalFields": {}
      },
      "name": "Reply to User",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        500,
        0
      ],
      "id": "reply-to-user",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "url": "http://localhost:5678/webhook/grapevine",
        "method": "POST",
        "jsonParameters": true,
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "message",
              "value": "={{ $node[\"Telegram Trigger\"].json.message.text }}"
            },
            {
              "name": "response",
              "value": "={{ $json.choices[0].message.content }}"
            },
            {
              "name": "source",
              "value": "telegram"
            },
            {
              "name": "type",
              "value": "CHAT"
            },
            {
              "name": "session_id",
              "value": "telegram-{{ $node[\"Telegram Trigger\"].json.message.chat.id }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Log to Grapevine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        750,
        0
      ],
      "id": "log-grapevine"
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Ask Willow (OpenAI)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Willow (OpenAI)": {
      "main": [
        [
          {
            "node": "Reply to User",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log to Grapevine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
